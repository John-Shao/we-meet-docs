    "semantic": {
      "$description": "Public color API. A component should consume these roles instead of palette values.",
      "light": {
        "surface": {
          "canvas": { "$value": "{color.palette.neutral.50}" },
          "default": { "$value": "{color.palette.neutral.0}" },
          "muted": { "$value": "{color.palette.neutral.100}" },
          "raised": { "$value": "{color.palette.neutral.0}" }
        },
        "text": {
          "primary": { "$value": "{color.palette.neutral.950}" },
          "secondary": { "$value": "{color.palette.neutral.600}" },
          "disabled": { "$value": "{color.palette.neutral.400}" },
          "inverse": { "$value": "{color.palette.neutral.0}" },
          "link": { "$value": "{color.palette.brand.700}" }
        },
        "icon": {
          "primary": { "$value": "{color.palette.neutral.700}" },
          "secondary": { "$value": "{color.palette.neutral.600}" },
          "disabled": { "$value": "{color.palette.neutral.400}" }
        },
        "border": {
          "subtle": { "$value": "{color.palette.neutral.200}" },
          "default": { "$value": "{color.palette.neutral.300}" },
          "strong": { "$value": "{color.palette.neutral.500}" },
          "focus": { "$value": "{color.palette.brand.500}" }
        },
        "action": {
          "primary": {
            "background": { "$value": "{color.palette.brand.600}" },
            "foreground": { "$value": "{color.palette.neutral.0}" },
            "hover": { "$value": "{color.palette.brand.700}" },
            "pressed": { "$value": "{color.palette.brand.800}" }
          },
          "selected": {
            "container": { "$value": "{color.palette.brand.100}" },
            "on-container": { "$value": "{color.palette.brand.700}" }
          }
        },
        "status": {
          "danger": {
            "default": { "$value": "{color.palette.danger.default}" },
            "on-default": { "$value": "{color.palette.neutral.0}" },
            "container": { "$value": "{color.palette.danger.container}" },
            "on-container": { "$value": "{color.palette.danger.on-container}" }
          },
          "warning": {
            "default": { "$value": "{color.palette.warning.default}" },
            "on-default": { "$value": "{color.palette.neutral.950}" },
            "container": { "$value": "{color.palette.warning.container}" },
            "on-container": { "$value": "{color.palette.warning.on-container}" }
