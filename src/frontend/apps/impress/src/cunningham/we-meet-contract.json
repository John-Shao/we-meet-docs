  "space": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xxs": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } },
    "3xl": { "$value": { "value": 48, "unit": "px" } },
    "4xl": { "$value": { "value": 64, "unit": "px" } }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Semantic aliases. Prefer these when the purpose is stable; use space.* for composition.",
    "inline": {
      "tight": { "$value": "{space.xs}" },
      "default": { "$value": "{space.sm}" },
      "comfortable": { "$value": "{space.md}" }
    },
    "stack": {
      "tight": { "$value": "{space.xs}" },
      "default": { "$value": "{space.sm}" },
      "related": { "$value": "{space.lg}" },
      "section": { "$value": "{space.xl}" }
    },
    "inset": {
      "control": { "$value": "{space.sm}" },
      "card": { "$value": "{space.lg}" },
      "panel": { "$value": "{space.xl}" },
      "page": { "$value": "{space.lg}" }
    }
  },
  "component": {
    "controlHeight": {
      "$type": "dimension",
      "$description": "Visible control heights. Compact is the default for dense Web forms; large is also the minimum Android interaction target.",
      "compact": { "$value": { "value": 32, "unit": "px" } },
      "default": { "$value": { "value": 40, "unit": "px" } },
      "large": { "$value": { "value": 48, "unit": "px" } }
    },
    "icon": {
      "$type": "dimension",
      "$description": "Glyph sizes for controls and navigation.",
      "small": { "$value": { "value": 16, "unit": "px" } },
      "medium": { "$value": { "value": 20, "unit": "px" } },
      "large": { "$value": { "value": 24, "unit": "px" } }
    },
    "iconButton": {
      "$type": "dimension",
      "$description": "Dense Web icon-button boxes. Android adds a 48dp semantic touch target around compact glyphs.",
      "compact": { "$value": { "value": 24, "unit": "px" } },
      "default": { "$value": { "value": 28, "unit": "px" } },
      "large": { "$value": { "value": 32, "unit": "px" } }
    },
    "selectionControl": {
      "$type": "dimension",
      "$description": "Visible checkbox and radio indicators; interaction targets may be larger.",
      "compact": { "$value": { "value": 18, "unit": "px" } },
      "default": { "$value": { "value": 22, "unit": "px" } }
    },
    "interactionTarget": {
      "$type": "dimension",
      "minimum": { "$value": { "value": 48, "unit": "px" } }
    }
  }
}
