  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Noto Sans",
          "sans-serif"
        ]
