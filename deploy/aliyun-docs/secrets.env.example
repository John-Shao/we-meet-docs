# secrets.env.example — Docs 独立机部署密钥模板（P3 协作文档）
#
# 用法：
#   cp secrets.env.example secrets.env    # secrets.env 已 gitignore，绝不入库
#   # 填好下面每一项
#   bash deploy/aliyun-docs/deploy-impress.sh      # 经 envsubst 注入 docs.values.yaml 的 ${...} 占位
#
# 随机值生成： openssl rand -hex 32
# ⚠️ DOCS_S2S_TOKEN 必须与 meet 后端 values.secrets.yaml 的 DOCS_SERVER_TO_SERVER_TOKEN 逐字符同值。
# ---------------------------------------------------------------------------

# Keycloak realm `meet` 的 docs client secret（bootstrap-docs-client.sh 末尾打印）
DOCS_CLIENT_SECRET=

# 妙记落 Doc 的服务端 token（与 meet 后端同值；openssl rand -hex 32）
DOCS_S2S_TOKEN=

# Django 密钥（openssl rand -hex 32）
DJANGO_SECRET_KEY=

# Docs 专属 PG / Redis 密码
DOCS_DB_PASSWORD=
DOCS_REDIS_PASSWORD=

# 阿里云 OSS 深圳 AK/SK（对 we-meet-docs 桶有读写权限的 RAM 用户）
OSS_AK=
OSS_SK=

# 协同 ws（y-provider）— 各生成一个 openssl rand -hex 32
Y_PROVIDER_API_KEY=
COLLAB_SERVER_SECRET=

# 邮件 SMTP（可选；不发邮件可留空，注意 chart 是否要求）
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
